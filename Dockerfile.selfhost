# Stage 1: Build frontend from source
FROM node:22-slim AS frontend

WORKDIR /web
ARG FRONTEND_REPO=https://github.com/rolandng84/lncrawl-web.git
ARG FRONTEND_BRANCH=main

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${FRONTEND_BRANCH} ${FRONTEND_REPO} .
RUN npm ci --ignore-scripts && npm run build

# Stage 2: Application (uses upstream base image with calibre + system deps)
ARG BASE_IMAGE=ghcr.io/lncrawl/lncrawl-base:latest
FROM ${BASE_IMAGE} AS app

WORKDIR /app

# Install Python dependencies (cached layer)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Copy application code
COPY LICENSE ./
COPY lncrawl ./lncrawl
COPY sources ./sources

# Replace submodule web dir with our freshly built frontend
RUN rm -rf lncrawl/server/web
COPY --from=frontend /web/dist ./lncrawl/server/web

# Data directory
ENV LNCRAWL_DATA_PATH=/data
VOLUME /data

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/api/ping')" || exit 1

ENTRYPOINT ["uv", "run", "python", "-m", "lncrawl"]
CMD ["-ll", "server"]
