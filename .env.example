# Lightnovel Crawler - Self-hosted Configuration
# Copy to .env and adjust values

# ── Required ──────────────────────────────────────────────────────────
# PostgreSQL password (used by both postgres and server services)
POSTGRES_PASSWORD=changeme

# ── Optional ──────────────────────────────────────────────────────────
# External port (default: 8080)
PORT=8080

# Admin credentials (defaults: admin / admin)
LNCRAWL_ADMIN_EMAIL=admin
LNCRAWL_ADMIN_PASSWORD=admin

# JWT token secret (auto-generated on first run if empty)
LNCRAWL_TOKEN_SECRET=

# Public base URL (for links in emails, etc.)
LNCRAWL_BASE_URL=

# OpenAI API key (for GPT-powered features)
OPENAI_API_KEY=
